# Server & Environment
NODE_ENV=development
PORT=5000
API_URL=http://localhost:5000
FRONTEND_URL=http://localhost:3000

# Database
MONGODB_URI=mongodb://localhost:27017/ai_insurance_claims

# Redis & Background Workers
REDIS_URL=redis://localhost:6379

# JWT Authentication
JWT_SECRET=super_secret_jwt_key_ai_insurance_2026_production_ready
JWT_EXPIRES_IN=7d
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_ai_insurance_2026
JWT_REFRESH_EXPIRES_IN=30d

# AI Provider Abstraction Options: MOCK | OPENAI | GEMINI | ANTHROPIC
AI_PROVIDER=MOCK
OPENAI_API_KEY=your-openai-key-if-using-openai
GEMINI_API_KEY=your-gemini-key-if-using-gemini
ANTHROPIC_API_KEY=your-anthropic-key-if-using-anthropic

# Storage Provider Options: LOCAL | S3
STORAGE_PROVIDER=LOCAL
S3_ENDPOINT=http://localhost:9000
S3_BUCKET=insurance-claim-documents
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin

# CORS & Security
CORS_ORIGIN=http://localhost:3000
